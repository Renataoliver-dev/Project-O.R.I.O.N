#include <Arduino.h>
#include "esp_camera.h"
#include <WiFi.h>

#include "board_config.h"

// ===========================
// WIFI
// ===========================

const char *ssid = "MARLEY_2.4";
const char *password = "04397944393";

// Funcoes do CameraWebServer
void startCameraServer();
void setupLedFlash();

void setup() {

  Serial.begin(115200);
  Serial.setDebugOutput(true);
  Serial.println();

  Serial.println("==========================");
  Serial.println("   INICIANDO ESP32-CAM");
  Serial.println("==========================");

  // ===========================
  // CONFIGURACAO DA CAMERA
  // ===========================

  camera_config_t config;

  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;

  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;

  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;

  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;

  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;

  // ===========================
  // CLOCK DA CAMERA
  // ===========================

  // NAO colocar 50 MHz
  config.xclk_freq_hz = 20000000;

  // ===========================
  // CONFIGURACAO DO VIDEO
  // ===========================

  // 160x120 - bem leve para testar streaming
  config.frame_size = FRAMESIZE_QQVGA;

  // JPEG para transmissao pela rede
  config.pixel_format = PIXFORMAT_JPEG;

  // Mais compressao para deixar o stream mais leve
  config.jpeg_quality = 25;

  // Dois buffers para streaming
  config.fb_count = 2;

  // Sempre tenta entregar o frame mais recente
  config.grab_mode = CAMERA_GRAB_LATEST;

  // ===========================
  // PSRAM
  // ===========================

  if (psramFound()) {

    Serial.println("PSRAM encontrada!");

    config.fb_location = CAMERA_FB_IN_PSRAM;

  } else {

    Serial.println("PSRAM NAO encontrada!");

    config.fb_location = CAMERA_FB_IN_DRAM;

    // Configuracao mais segura sem PSRAM
    config.fb_count = 1;
    config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;
  }

  // ===========================
  // INICIALIZAR CAMERA
  // ===========================

  Serial.println("Inicializando camera...");

  esp_err_t err = esp_camera_init(&config);

  if (err != ESP_OK) {

    Serial.printf(
      "ERRO ao iniciar camera: 0x%x\n",
      err
    );

    return;
  }

  Serial.println("Camera inicializada!");

  // ===========================
  // SENSOR
  // ===========================

  sensor_t *s = esp_camera_sensor_get();

  if (s == NULL) {

    Serial.println("ERRO: sensor nao encontrado!");

    return;
  }

  Serial.printf(
    "Camera PID: 0x%04X\n",
    s->id.PID
  );

  // ===========================
  // OV3660
  // ===========================

  if (s->id.PID == OV3660_PID) {

    Serial.println("OV3660 detectada!");

    s->set_vflip(s, 1);

    s->set_brightness(s, 1);

    s->set_saturation(s, -2);
  }

  // Forca resolucao 160x120
  s->set_framesize(
    s,
    FRAMESIZE_QQVGA
  );

  // ===========================
  // LED
  // ===========================

#if defined(LED_GPIO_NUM)

  setupLedFlash();

#endif

  // ===========================
  // WIFI
  // ===========================

  Serial.println();
  Serial.print("Conectando ao WiFi");

  WiFi.begin(
    ssid,
    password
  );

  // Desativa economia de energia para reduzir atraso
  WiFi.setSleep(false);

  while (WiFi.status() != WL_CONNECTED) {

    delay(500);

    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi conectado!");

  Serial.print("IP: ");
  Serial.println(WiFi.localIP());

  // ===========================
  // SERVIDOR
  // ===========================

  Serial.println("Iniciando servidor...");

  startCameraServer();

  Serial.println();
  Serial.println("==========================");
  Serial.println("       CAMERA PRONTA");
  Serial.println("==========================");

  Serial.print("Pagina: http://");
  Serial.println(WiFi.localIP());

  Serial.print("VIDEO AO VIVO: http://");
  Serial.print(WiFi.localIP());
  Serial.println(":81/stream");

  Serial.println("==========================");
}

void loop() {

  // O servidor da camera roda em outra tarefa.
  delay(10000);
}
